# Ambiente da aplicação
APP_ENV=development
APP_NAME="ISLA Institutional AI Agent"
DEBUG=false

# Base de dados (PostgreSQL em produção/Docker; definir POSTGRES_PASSWORD obrigatório)
POSTGRES_USER=isla_ai
POSTGRES_PASSWORD=
POSTGRES_DB=isla_ai
DATABASE_URL=postgresql+psycopg://isla_ai:DEFINE_PASSWORD@localhost:5432/isla_ai

# Segurança e autenticação — gerar segredo aleatório forte com:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Autenticação institucional (API LDAP ISLA — X-API-Key mantido exclusivamente no backend)
# Deixar vazio em dev local; preencher com iag_live_<app-token> após aprovação institucional
AUTH_MODE=hybrid
INSTITUTIONAL_AUTH_BASE_URL=https://cksi-dev.islagaia.pt
INSTITUTIONAL_AUTH_API_KEY=
INSTITUTIONAL_AUTH_ORIGIN=http://localhost:5173

# Portal Científico do ISLA (mantido exclusivamente no backend)
PORTAL_API_BASE_URL=https://portalcientifico.islagaia.pt
PORTAL_API_PUBLICATIONS_PATH=/api/powerbi/publications
PORTAL_API_TOKEN=
PORTAL_API_TIMEOUT_SECONDS=60
PORTAL_AUTO_SYNC_ENABLED=true
PORTAL_AUTO_SYNC_INTERVAL_MINUTES=720

# Retenção e limites
MAX_EXCEL_UPLOAD_MB=20
CONVERSATION_RETENTION_DAYS=365

# LLM local / on-premise (RGPD & NIS2: endpoints externos bloqueados por defeito)
# Usar 'unconfigured'/'deterministic' (offline) ou 'openai_compatible' com Ollama/vLLM local:
#   Modelos recomendados para 6–8 GB VRAM em PT com tool calling rápido: qwen2.5:7b (~4.7 GB) ou qwen3:8b (~5.2 GB)
LLM_PROVIDER=unconfigured
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_ALLOW_EXTERNAL_ENDPOINTS=false
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOOL_STEPS=5
LLM_REASONING_EFFORT=none
